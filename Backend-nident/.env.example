APP_NAME=Nident
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nident
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=-05:00
NIDENT_MODE=true
NIDENT_DATABASE=nident
NIDENT_FRONTEND_URL=http://localhost:4321
NIDENT_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
NIDENT_LEGACY_SCHEDULER=false
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=60
JWT_SECRET=
JWT_TTL=60
JWT_BLACKLIST_ENABLED=true
AUTH_REFRESH_DAYS_SHORT=1
MAIL_MAILER=log
MAIL_FROM_NAME=Nident
MAIL_FROM_ADDRESS=
MAIL_CONTACT_TO=
# SMTP and recipients are configured through /admin/correos, not inherited.
