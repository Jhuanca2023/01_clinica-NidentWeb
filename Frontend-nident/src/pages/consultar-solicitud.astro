---
import '../styles/claims.css';
import PublicOperations from '../layouts/PublicOperations.astro';
const reference=Astro.url.searchParams.get('ref')||'';
---
<PublicOperations title="Consultar solicitud"><section class="public-operation" style="max-width:900px"><h1>Consulta tu solicitud.</h1><p>Ingresa la referencia que recibiste y el correo que registraste. Puedes revisar reservas, mensajes de contacto y reclamaciones sin crear una cuenta.</p><form id="request-lookup"><label>Referencia<input name="reference" value={reference} placeholder="NID-…" required maxlength="30" autocomplete="off"/></label><label>Correo registrado<input type="email" name="email" required maxlength="180" autocomplete="email"/></label><button class="btn pri" type="submit">Consultar estado</button><p id="lookup-feedback" class="public-feedback" role="status" hidden></p></form><section id="lookup-result" class="public-result" role="status" hidden></section></section><script>import '../scripts/claim-tracking';</script></PublicOperations>
