---
import PublicOperations from '../layouts/PublicOperations.astro';
const reference=Astro.url.searchParams.get('ref')||'';
---
<PublicOperations title="Consultar solicitud"><section class="public-operation" style="max-width:620px"><h1>Consulta tu solicitud.</h1><p>Ingresa la referencia que recibiste y el correo que registraste. Puedes revisar reservas, mensajes de contacto y reclamaciones sin crear una cuenta.</p><form id="request-lookup"><label>Referencia<input name="reference" value={reference} placeholder="NID-…" required maxlength="30" autocomplete="off"/></label><label>Correo registrado<input type="email" name="email" required maxlength="180" autocomplete="email"/></label><button class="btn pri" type="submit">Consultar estado</button><p id="lookup-feedback" class="public-feedback" role="status" hidden></p></form><section id="lookup-result" class="public-result" role="status" hidden></section></section><script>
import {notificationCopy} from '../lib/notification-copy';const form=document.getElementById('request-lookup') as HTMLFormElement;const labels:Record<string,string>={pending:'Pendiente de confirmación',confirmed:'Cita confirmada',cancelled:'Cita cancelada',completed:'Atendida',received:'Solicitud recibida',reviewed:'Mensaje revisado',reviewing:'En revisión',answered:'Respuesta registrada'};
form?.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const feedback=document.getElementById('lookup-feedback')!;const result=document.getElementById('lookup-result')!;feedback.hidden=true;result.hidden=true;try{const response=await fetch('/api/consultar-solicitud',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const body=await response.json();if(!response.ok)throw Error(body.message||'No se pudo consultar la solicitud.');const data=body.result;result.replaceChildren();const title=document.createElement('h2');title.textContent=labels[data.status]||data.status;const reference=document.createElement('p');reference.textContent=`${data.reference} · ${data.type==='reservation'?'Reserva':data.type==='claim'?'Reclamación':'Mensaje de contacto'}`;const note=document.createElement('p');note.textContent=notificationCopy(data.notification);result.append(title,reference);if(data.date){const date=document.createElement('p');date.textContent=`${data.status==='confirmed'?'Fecha confirmada':'Fecha solicitada'}: ${data.date} · ${data.time} · Perú`;result.append(date);}result.append(note);result.hidden=false;}catch(error){feedback.textContent=(error as Error).message;feedback.className='public-feedback error';feedback.hidden=false;}finally{button.disabled=false;}});
</script></PublicOperations>
