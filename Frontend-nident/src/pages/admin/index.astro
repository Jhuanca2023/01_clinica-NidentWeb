---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {api,ApiError} from '../../lib/server/api';
import {reservationChart} from '../../lib/dashboard';
const requested=Number(Astro.url.searchParams.get('days')||30);const days=[7,30,90].includes(requested)?requested:30;
let user:any;let dashboard:any;let error='';
try{const responses=await Promise.all([api('/admin/me',{token:Astro.locals.token}),api('/admin/dashboard?days='+days,{token:Astro.locals.token})]);user=responses[0].result;dashboard=responses[1].result;}
catch(e){if(e instanceof ApiError&&[401,403].includes(e.status)){Astro.session!.destroy();return Astro.redirect('/admin/login');}error='No se pudo cargar el dashboard. Intenta nuevamente.';}
const reservations=dashboard?.reservations;const chart=reservationChart(reservations?.series || []);
const statuses=[{key:'pending',label:'Pendientes',color:'#a77724'},{key:'confirmed',label:'Confirmadas',color:'#7258b6'},{key:'completed',label:'Atendidas',color:'#32765b'},{key:'cancelled',label:'Canceladas',color:'#b04c62'}];
const metrics=[...(reservations?[{label:'Solicitudes recibidas',value:reservations.total,note:`Últimos ${days} días`,href:'/admin/reservas'},{label:'Por confirmar',value:reservations.pending,note:'Pendientes de todas las fechas',href:'/admin/reservas?status=pending'},{label:'Citas confirmadas hoy',value:reservations.today,note:'Fecha de atención · Perú',href:'/admin/reservas?status=confirmed'}]:[]),...(dashboard?.messages?[{label:'Mensajes sin leer',value:dashboard.messages.unread,note:`${dashboard.messages.total} recibidos en el período`,href:'/admin/mensajes'}]:[]),...(dashboard?.mail?[{label:'Correos enviados',value:dashboard.mail.sent||0,note:`${dashboard.mail.simulated||0} simulados · últimos ${days} días`,href:'/admin/correos'}]:[]),...(dashboard?.content?[{label:'Páginas publicadas',value:dashboard.content.pages,note:`${dashboard.content.drafts} módulos con borradores distintos`,href:'/admin/sitio'}]:[])];
const branches=reservations?.branches || [];const maxBranch=Math.max(1,...branches.map((branch:any)=>Number(branch.total)));
const mailLabels:Record<string,string>={pending:'Pendientes',queued:'En cola',sending:'En proceso',sent:'Enviados',simulated:'Simulados',failed:'Fallidos'};
---
<AdminLayout title="Vista general" active="home"><header class="page-heading dashboard-heading"><div><h1>Así va Nident.</h1><p>{user?`Hola, ${user.name}. Aquí tienes la actividad de tu clínica.`:error}</p></div><form method="get" class="dashboard-period"><label>Período<select name="days" id="dashboard-period">{[7,30,90].map(value=><option value={value} selected={value===days}>Últimos {value} días</option>)}</select></label><button class="secondary" type="submit">Actualizar</button></form></header>
{error?<p class="notice error">{error}</p>:<><div class="dashboard-metrics">{metrics.map(metric=><a href={metric.href}><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.note}</small></a>)}</div>
{reservations&&<><div class="dashboard-charts"><section class="dashboard-panel activity-panel"><div class="dashboard-panel-heading"><div><h2>Solicitudes de reserva</h2><p>Por fecha de registro · últimos {days} días</p></div><a href="/admin/reservas">Ver reservas</a></div><div class="activity-chart"><svg viewBox="0 0 760 240" role="img" aria-label={`Solicitudes recibidas por día. ${reservations.total} en los últimos ${days} días.`}>{chart.ticks.map(tick=><g><line x1="34" x2="730" y1={tick.y} y2={tick.y} stroke="#e9e3ef"/><text x="22" y={tick.y+4} text-anchor="end">{tick.label}</text></g>)}<path d={chart.area} fill="#eee7f9"/><path d={chart.line} fill="none" stroke="#7258b6" stroke-width="2.5" stroke-linejoin="round"/>{chart.points.map(point=><g tabindex="0" role="img" aria-label={`${point.label}: ${point.total} solicitudes`}><title>{point.label}: {point.total} solicitudes</title><circle cx={point.x} cy={point.y} r="8" fill="transparent"/><circle cx={point.x} cy={point.y} r="3" fill="#7258b6"/></g>)}{chart.labels.map(point=><text x={point.x} y="228" text-anchor="middle">{point.label}</text>)}</svg></div>{reservations.total===0&&<p class="chart-empty">Todavía no hay solicitudes en este período. La gráfica se actualizará al recibir reservas.</p>}<details class="chart-table"><summary>Ver datos por día</summary><table><thead><tr><th>Fecha</th><th>Solicitudes</th></tr></thead><tbody>{chart.points.map(point=><tr><td>{point.label}</td><td>{point.total}</td></tr>)}</tbody></table></details></section>
<section class="dashboard-panel"><div class="dashboard-panel-heading"><div><h2>Estado de las reservas</h2><p>Solicitudes recibidas en el período</p></div></div><div class="status-chart">{statuses.map(status=>{const total=Number(reservations.statuses[status.key]||0);return <div><div><span><i style={`background:${status.color}`}></i>{status.label}</span><b>{total}</b></div><div class="dashboard-bar"><span style={`width:${total/Math.max(1,reservations.total)*100}%;background:${status.color}`}></span></div></div>;})}</div><p class="small-note">Las solicitudes pendientes requieren revisión de disponibilidad y confirmación del equipo.</p></section></div>
<div class="dashboard-secondary"><section class="dashboard-panel"><div class="dashboard-panel-heading"><div><h2>Reservas por sede</h2><p>Preferencia indicada al enviar la solicitud</p></div></div>{branches.length?<div class="status-chart">{branches.map((branch:any)=><div><div><span>{branch.branch}</span><b>{branch.total}</b></div><div class="dashboard-bar"><span style={`width:${Number(branch.total)/maxBranch*100}%`}></span></div></div>)}</div>:<p class="chart-empty">Las sedes aparecerán aquí cuando recibas solicitudes.</p>}</section><section class="dashboard-panel"><div class="dashboard-panel-heading"><div><h2>Próximas citas</h2><p>Solo visitas confirmadas</p></div><a href="/admin/reservas?status=confirmed">Ver agenda</a></div>{reservations.upcoming.length?<ul class="upcoming-list">{reservations.upcoming.map((visit:any)=><li><div><b>{visit.preferred_date} · {visit.preferred_time}</b><span>{visit.branch}</span></div><a href={'/admin/reservas?search='+encodeURIComponent(visit.code)}>{visit.code}</a></li>)}</ul>:<p class="chart-empty">Aún no hay próximas citas confirmadas.</p>}</section></div></>}
<div class="dashboard-secondary">{dashboard.mail&&<section class="dashboard-panel"><div class="dashboard-panel-heading"><div><h2>Comunicaciones</h2><p>Actividad de correo del período</p></div><a href="/admin/correos">Gestionar correos</a></div><dl class="mail-totals">{Object.entries(mailLabels).map(([status,label])=><div><dt>{label}</dt><dd>{dashboard.mail[status]||0}</dd></div>)}</dl><p class="small-note">Los simulados no son envíos. Enviado indica aceptación por el transporte.</p></section>}{dashboard.content&&<section class="dashboard-panel"><div class="dashboard-panel-heading"><div><h2>Tu contenido publicado</h2><p>Gestiona las colecciones de tu sitio</p></div></div><a class="dashboard-content-link" href="/admin/resenas"><span>Reseñas visibles</span><b>{dashboard.content.collections.reviews||0}</b><span>Administrar</span></a><a class="dashboard-content-link" href="/admin/planes"><span>Planes visibles</span><b>{dashboard.content.collections.plans||0}</b><span>Administrar</span></a><a class="dashboard-content-link" href="/admin/sliders"><span>Sliders de inicio</span><span>Editar colección</span></a></section>}</div><p class="dashboard-freshness">Datos reales del sistema · {dashboard.timezone} · Actualizado {new Date(dashboard.generated_at).toLocaleString('es-PE',{timeZone:'America/Lima'})}</p></>}
</AdminLayout>
