---
import AdminLayout from '../../layouts/AdminLayout.astro';import ClaimsList from '../../components/ClaimsList.astro';import {api,ApiError} from '../../lib/server/api';import '../../styles/claims.css';
let result:any,business:any,me:any,error='';const query=new URLSearchParams();for(const key of ['status','type','outcome','search','page','per_page']){const value=Astro.url.searchParams.get(key);if(value)query.set(key,value);}
try{const responses=await Promise.all([api('/admin/claims?'+query,{token:Astro.locals.token}),api('/admin/claims/settings',{token:Astro.locals.token}),api('/admin/me',{token:Astro.locals.token})]);result=responses[0].result;business=responses[1].result;me=responses[2].result;if(result.current_page>result.last_page){query.set('page',String(result.last_page));return Astro.redirect('/admin/reclamaciones?'+query);}}catch(errorValue){if(errorValue instanceof ApiError&&errorValue.status===401)return Astro.redirect('/admin/login');error=errorValue instanceof Error?errorValue.message:'No se pudo abrir el Libro de Reclamaciones.';}
---
<AdminLayout title="Libro de Reclamaciones" active="claims">{error?<p class="notice error">{error}</p>:<ClaimsList {result} {business} {me} {query}/>}</AdminLayout>
