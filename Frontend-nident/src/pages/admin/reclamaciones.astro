---
import AdminLayout from '../../layouts/AdminLayout.astro';import {api,ApiError} from '../../lib/server/api';let result:any,business:any,me:any;let error='';const query=new URLSearchParams();for(const key of ['status','search','page']){const value=Astro.url.searchParams.get(key);if(value)query.set(key,value);}try{const responses=await Promise.all([api('/admin/claims?'+query,{token:Astro.locals.token}),api('/admin/claims/settings',{token:Astro.locals.token}),api('/admin/me',{token:Astro.locals.token})]);result=responses[0].result;business=responses[1].result;me=responses[2].result;}catch(e){if(e instanceof ApiError&&e.status===401)return Astro.redirect('/admin/login');error=e instanceof Error?e.message:'No se pudo abrir el Libro de Reclamaciones.';}
const labels:Record<string,string>={received:'Recibida',reviewing:'En revisión',answered:'Respondida'};const pageLink=(page:number)=>{const params=new URLSearchParams(query);params.set('page',String(page));return '/admin/reclamaciones?'+params;};
---
<AdminLayout title="Libro de Reclamaciones" active="claims"><header class="page-heading"><div><h1>Libro de Reclamaciones</h1><p>Revisa las solicitudes, sus documentos y la respuesta enviada al consumidor.</p></div><a class="secondary button" href="/libro-reclamaciones" target="_blank" rel="noopener">Ver formulario público</a></header><p class="notice" id="claims-feedback" role="status" hidden></p>{error?<p class="notice error">{error}</p>:<>{me?.permissions.security&&<details class="operations-panel" style="margin-bottom:22px"><summary>Datos del proveedor {business?.tax_id?'':'· pendientes de completar'}</summary><form id="business-form" class="form-grid" data-version={business?.version} style="margin-top:22px">{Object.entries({commercial_name:'Nombre comercial',legal_name:'Razón social',tax_id:'RUC',address:'Domicilio del proveedor',email:'Correo de atención'}).map(([key,label])=><label>{label}<input name={key} value={business?.[key]||''} required maxlength={key==='tax_id'?11:300}/></label>)}<button class="primary" type="submit">Guardar datos del proveedor</button></form></details>}<form class="reservation-filters" method="get"><label>Buscar por referencia o nombre<input name="search" value={query.get('search')||''}/></label><label>Estado<select name="status"><option value="">Todas</option>{Object.entries(labels).map(([status,label])=><option value={status} selected={query.get('status')===status}>{label}</option>)}</select></label><button class="primary">Filtrar</button><a href="/admin/reclamaciones">Limpiar</a></form><div class="reservation-results"><span>{result.total} solicitudes</span><span>Página {result.current_page} de {result.last_page}</span></div>{!result.data.length&&<section class="operations-panel"><h2 style="font-size:16px">No hay solicitudes en esta vista.</h2><p class="small-note" style="margin-top:10px">Las reclamaciones registradas en el formulario aparecerán aquí.</p></section>}{result.data.map((claim:any)=><details class="reservation-row"><summary><div><b>{claim.reference} · {claim.type}</b><span>{claim.name} · {claim.created_at}</span></div><span class={'status-pill '+claim.status}>{labels[claim.status]}</span></summary><div class="reservation-detail"><div class="message-content"><h2>Datos de la solicitud</h2><p>{claim.email} · {claim.phone}</p><p>{claim.document_type} · {claim.document_number}</p><p>{claim.address}</p><h3>Producto o servicio</h3><p>{claim.service}{claim.amount&&` · S/ ${claim.amount}`}</p><h3>Detalle</h3><p class="message-text">{claim.detail}</p><h3>Pedido del consumidor</h3><p class="message-text">{claim.requested_solution}</p>{claim.minor&&<p>Representante: {claim.guardian} · {claim.guardian_email} · {claim.guardian_phone}</p>}{claim.attachments.length>0&&<><h3>Adjuntos privados</h3>{claim.attachments.map((file:any)=><a href={`/admin/adjuntos/${claim.id}/${file.index}`} download>{file.name}</a>)}</>}</div><form data-claim={claim.id} data-version={claim.version}><label>Estado<select name="status">{Object.entries(labels).filter(([status])=>claim.status!=='answered'||status==='answered').map(([status,label])=><option value={status} selected={claim.status===status}>{label}</option>)}</select></label><label>Respuesta al consumidor<textarea name="response" rows="8" minlength="5" maxlength="6000">{claim.response}</textarea></label><p class="small-note">Al marcar Respondida, la respuesta se prepara para el correo registrado. Puedes comprobar su entrega en Correos y plantillas.</p><button class="primary" type="submit">Guardar atención</button></form></div></details>)}<nav class="message-pagination">{result.current_page>1&&<a href={pageLink(result.current_page-1)}>Anterior</a>}{result.current_page<result.last_page&&<a href={pageLink(result.current_page+1)}>Siguiente</a>}</nav></>}
<script>
const csrf=document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')!.content;async function save(path:string,body:unknown){const response=await fetch('/admin/actions/'+path,{method:'PUT',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(body)});const data=await response.json();if(!response.ok)throw Error(data.errors?Object.values(data.errors).flat().join(' '):data.message);return data;}
document.querySelectorAll<HTMLFormElement>('[data-claim],#business-form').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const feedback=document.getElementById('claims-feedback')!;try{await save(form.id==='business-form'?'security/business':'claims/'+form.dataset.claim,{...Object.fromEntries(new FormData(form)),version:Number(form.dataset.version)});location.reload();}catch(error){feedback.hidden=false;feedback.textContent=(error as Error).message;feedback.className='notice error';button.disabled=false;}}));
</script></AdminLayout>
