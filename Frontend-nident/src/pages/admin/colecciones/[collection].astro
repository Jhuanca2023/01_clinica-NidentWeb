---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {api,ApiError} from '../../../lib/server/api';
import {canvasPages} from '../../../lib/canvas';
const kind=Astro.params.collection;
if(kind!=='reviews'&&kind!=='plans'&&kind!=='products')return Astro.redirect('/admin');
const reviews=kind==='reviews';const products=kind==='products';const name=reviews?'Reseñas':products?'Productos':'Planes y promociones';
let document:any;let error='';
try{document=(await api(products?'/admin/catalog':'/admin/site/collections/'+kind,{token:Astro.locals.token})).result;}
catch(e){if(e instanceof ApiError&&e.status===401)return Astro.redirect('/admin/login');error=e instanceof Error?e.message:'No se pudo abrir la colección.';}
const page=canvasPages.find(p=>p.path==='/')!;
---
<AdminLayout title={name} active={products?'catalog':kind}><header class="page-heading"><div><h1>{reviews?'Reseñas':products?'Productos':'Planes y promociones'}</h1><p>{reviews?'Agrega reseñas, cambia su contenido y elige cuáles mostrar.':products?'Agrega productos, imágenes, precios y disponibilidad al catálogo de tu tienda.':'Crea planes con sus propias imágenes, inclusiones, condiciones y secciones de información.'}</p></div><a class="secondary button" href={reviews?'/#resenas':products?'/tienda':'/promociones'} target="_blank" rel="noopener">Ver en el sitio</a></header>
{error?<p class="notice error">{error}</p>:<section id="collection-app"><div class="studio-toolbar"><span id="collection-state" role="status">Borrador guardado</span><div><button id="collection-add" class="secondary">{reviews?'Nueva reseña':products?'Nuevo producto':'Nuevo plan'}</button><button id="collection-save" class="secondary" disabled>Guardar borrador</button><button id="collection-publish" class="primary">Publicar colección</button></div></div><p class="notice" id="collection-feedback" role="status" hidden></p><div id="collection-undo" class="undo-strip" hidden><span>Elemento eliminado del borrador.</span><button class="text-button" id="undo-remove">Deshacer</button></div><div class="collection-workbench"><aside class="collection-library"><label>Buscar {reviews?'reseña':products?'producto':'plan'}<input id="collection-search" type="search" placeholder={reviews?'Nombre o tratamiento…':products?'Nombre del producto…':'Nombre del plan…'}/></label><p class="small-note" id="collection-count"></p><div id="collection-list"></div></aside><section class="site-stage collection-stage"><div class="stage-tools"><span>Vista previa del borrador</span><span>Haz clic en una tarjeta para editarla</span></div><iframe id="collection-frame" title={`Lienzo de ${name.toLocaleLowerCase()}`} sandbox="allow-same-origin"></iframe></section><aside class="site-inspector collection-inspector"><div class="inspector-heading"><h2 id="collection-item-heading">Editar contenido</h2><span id="item-position" class="small-note"></span></div><div class="collection-item-actions"><button class="secondary" id="item-before" aria-label="Mover elemento antes">Mover antes</button><button class="secondary" id="item-after" aria-label="Mover elemento después">Mover después</button><button class="secondary" id="item-duplicate">Duplicar</button><button class="danger" id="item-remove">Eliminar</button></div><div id="collection-fields"></div><p class="small-note">Los elementos ocultos no se muestran al publicar. Guardar conserva el borrador; publicar actualiza la colección en el sitio.</p></aside></div><script id="collection-data" type="application/json" set:html={JSON.stringify({kind,document,head:page.head}).replace(/</g,'\\u003c')}/></section>}
<script>import '../../../scripts/collection-editor';</script>
</AdminLayout>
