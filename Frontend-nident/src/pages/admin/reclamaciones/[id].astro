---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {api,ApiError} from '../../../lib/server/api';import {claimLabel,claimDate,claimProgress}from'../../../lib/claims';import '../../../styles/claims.css';
const id=Astro.params.id||'';if(!/^\d+$/.test(id))return Astro.redirect('/admin/reclamaciones');let claim:any,me:any,error='';try{[claim,me]=await Promise.all([api('/admin/claims/'+id,{token:Astro.locals.token}).then(result=>result.result),api('/admin/me',{token:Astro.locals.token}).then(result=>result.result)]);}catch(e){if(e instanceof ApiError&&e.status===401)return Astro.redirect('/admin/login');Astro.response.status=e instanceof ApiError?e.status:503;error=e instanceof Error?e.message:'No se pudo abrir la solicitud.';}
---
<AdminLayout title="Atender reclamación" active="claims">{error?<p class="notice error">{error}</p>:<section id="claim-detail" data-id={claim.id} data-version={claim.version}><header class="claim-detail-header"><div><h1>{claim.number}</h1><div><span class={'claim-type '+claim.type}>{claim.type==='queja'?'Queja':'Reclamo'}</span><span id="claim-status" class={'claim-state '+claim.status}>{claimLabel(claim.status,claim.outcome)}</span></div><p>{claim.name}<br/>Referencia de consulta: {claim.reference}<br/>Registrado: {claimDate(claim.created_at)}</p></div><a class="secondary button" href="/admin/reclamaciones">Volver al listado</a></header><div id="claim-progress" set:html={claimProgress(claim.status,{registered_at:claim.created_at,reviewing_at:claim.reviewing_at,answered_at:claim.answered_at})}/><p class="notice" id="claim-open-state" role="status">Abriendo ficha de atención…</p><button type="button" id="claim-open-retry" class="secondary" hidden>Reintentar apertura</button><div class="claim-detail-grid"><div class="claim-record-sections"><section class="claim-data"><h2>Datos personales</h2><dl>{Object.entries({'Nombre completo':claim.name,'Tipo de documento':claim.document_type,'Número de documento':claim.document_number,'Teléfono':claim.phone,'Correo':claim.email}).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>{claim.minor&&<><h3>Padre, madre o representante</h3><p>{claim.guardian}<br/>{claim.guardian_email} · {claim.guardian_phone}<br/>{claim.guardian_address}</p></>}</section><section class="claim-data"><h2>Domicilio</h2><dl>{Object.entries({'Departamento':claim.department,'Provincia':claim.province,'Distrito':claim.district,'Dirección':claim.address}).map(([label,value])=><div><dt>{label}</dt><dd>{value||'No indicado'}</dd></div>)}</dl></section><section class="claim-data"><h2>Detalles de la solicitud</h2><h3>Producto o servicio</h3><p>{claim.service_kind==='producto'?'Producto':'Servicio'} · {claim.service}</p>{claim.amount&&<><h3>Monto reclamado</h3><p>S/ {claim.amount}</p></>}<h3>Descripción del reclamo o queja</h3><p>{claim.detail}</p><h3>Pedido del consumidor</h3><p>{claim.requested_solution}</p>{claim.attachments.length>0&&<><h3>Documentos adjuntos</h3><div class="claim-attachments">{claim.attachments.map((file:any)=><a href={'/admin/adjuntos/'+claim.id+'/'+file.index} download>{file.name}</a>)}</div></>}</section>{claim.history.length>0&&<section class="claim-data"><h2>Historial de atención</h2><ol class="claim-history">{claim.history.map((event:any)=><li>{claimLabel(event.status,event.outcome)} · {claimDate(event.created_at)} · versión {event.version}</li>)}</ol></section>}</div><section class="workspace-form claim-management"><h2>Gestión del reclamo</h2><form id="claim-management-form"><fieldset disabled><label>Estado de atención<select name="status"><option value="reviewing" selected={claim.status!=='answered'}>En proceso</option><option value="answered" selected={claim.status==='answered'}>Finalizado</option></select></label><label id="claim-outcome-field" hidden>Resultado<select name="outcome"><option value="resolved" selected={claim.outcome!=='rejected'}>Resuelto</option><option value="rejected" selected={claim.outcome==='rejected'}>Rechazado</option></select></label><label>Responsable de atención<input name="responsible_name" value={claim.responsible_name||me.name||''} required maxlength="150"/></label><label>Respuesta o comentario<textarea name="response" rows="8" minlength="5" maxlength="6000">{claim.response}</textarea></label><p class="small-note">Los comentarios de una solicitud en proceso son internos. Al finalizar, la respuesta se muestra al consumidor en su consulta y se prepara el correo de respuesta.</p><button class="primary" type="submit">Guardar gestión</button></fieldset><p id="claim-save-feedback" role="status" hidden></p></form></section></div></section>}<script>import '../../../scripts/claim-admin';</script></AdminLayout>
