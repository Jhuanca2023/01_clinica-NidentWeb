---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { api, ApiError } from '../../lib/server/api';
let messages: any; let error = '';
const pageNumber = Math.max(1, Math.min(10000, Number.parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1));
const query=new URLSearchParams();for(const key of ['search','status','date_from','date_to','per_page']){const value=Astro.url.searchParams.get(key);if(value)query.set(key,value);}query.set('page',String(pageNumber));
const pageLink=(page:number)=>{const params=new URLSearchParams(query);params.set('page',String(page));return '/admin/mensajes?'+params;};
try {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const id = Number(form.get('id'));
    if (Number.isSafeInteger(id) && id > 0) await api(`/admin/messages/${id}/read`, { method: 'POST', token: Astro.locals.token, body: {} });
    return Astro.redirect(pageLink(pageNumber));
  }
  messages = (await api('/admin/messages?'+query, { token: Astro.locals.token })).result;
  if(messages.current_page>messages.last_page)return Astro.redirect(pageLink(messages.last_page));
} catch (exception) { if (exception instanceof ApiError && exception.status === 401) return Astro.redirect('/admin/login'); error = exception instanceof ApiError ? exception.message : 'No pudimos abrir los mensajes.'; }
---
<AdminLayout title="Mensajes" active="attention"><header class="page-heading"><div><h1>Cada consulta merece atención.</h1><p>Mensajes recibidos desde el formulario de Nident.</p></div></header>
<form class="reservation-filters message-filters" method="get"><label>Buscar nombre, correo, teléfono o referencia<input name="search" value={query.get('search')||''} maxlength="120"/></label><label>Estado<select name="status"><option value="">Todos</option><option value="unread" selected={query.get('status')==='unread'}>Por revisar</option><option value="read" selected={query.get('status')==='read'}>Leídos</option></select></label><label>Desde<input name="date_from" type="date" value={query.get('date_from')||''}/></label><label>Hasta<input name="date_to" type="date" value={query.get('date_to')||''}/></label><label>Por página<select name="per_page">{[20,50,100].map(size=><option value={size} selected={String(size)===(query.get('per_page')||'20')}>{size}</option>)}</select></label><button class="primary">Filtrar mensajes</button><a href="/admin/mensajes">Limpiar</a></form>
{messages&&<div class="reservation-results"><span>{messages.total} mensajes encontrados</span><span>Página {messages.current_page} de {messages.last_page}</span></div>}
{error ? <p class="notice error">{error}</p> : messages?.data.length ? <div class="page-settings-list">{messages.data.map((message: any) => <details><summary>{message.nombre} · {message.asunto} <span class="small-note">{message.nident_read_at ? 'Leído' : 'Por revisar'}</span></summary><div class="message-content"><p class="small-note">{message.nident_reference} · {message.created_at}</p><p><a href={`mailto:${message.email}`}>{message.email}</a>{message.telefono && ` · ${message.telefono}`}</p><p>Sede o interés: {message.producto_interes}</p><p class="message-text">{message.mensaje}</p>{!message.nident_read_at && <form method="post"><input type="hidden" name="_csrf" value={Astro.locals.csrf}/><input type="hidden" name="id" value={message.id}/><button class="secondary" type="submit">Marcar como leído</button></form>}</div></details>)}</div> : <p class="empty-state">No hay mensajes en esta vista. Prueba otros filtros o espera nuevas consultas.</p>}
{messages && messages.last_page > 1 && <nav class="message-pagination" aria-label="Páginas de mensajes">{pageNumber > 1 && <a class="secondary button" href={pageLink(pageNumber-1)}>Anteriores</a>}<span>Página {messages.current_page} de {messages.last_page}</span>{pageNumber < messages.last_page && <a class="secondary button" href={pageLink(pageNumber+1)}>Siguientes</a>}</nav>}
</AdminLayout>
