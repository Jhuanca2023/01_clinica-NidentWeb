---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {api,ApiError} from '../../../lib/server/api';
const type=Astro.params.type || 'users';if(!['users','profiles','roles'].includes(type))return Astro.redirect('/admin');
let data:any;let me:any;let error='';try{[data,me]=await Promise.all([api('/admin/security',{token:Astro.locals.token}),api('/admin/me',{token:Astro.locals.token})]);data=data.result;me=me.result;}catch(e){if(e instanceof ApiError&&e.status===401)return Astro.redirect('/admin/login');error=e instanceof Error?e.message:'No se pudo abrir la gestión de accesos.';}
const labels:Record<string,string>={users:'Usuarios',profiles:'Perfiles',roles:'Roles y permisos'};const singular=type==='users'?'usuario':type==='profiles'?'perfil':'rol';
---
<AdminLayout title={labels[type]} active={type}><header class="page-heading"><div><h1>{labels[type]}</h1><p>{type==='users'?'Crea las cuentas del personal y asigna los perfiles que necesita para trabajar.':type==='profiles'?'Agrupa roles para asignar los mismos accesos al personal.':'Define qué módulos puede utilizar cada función del equipo.'}</p></div><button class="primary" id="security-new">Nuevo {singular}</button></header>{error?<p class="notice error">{error}</p>:<><nav class="tab-bar"><a href="/admin/usuarios" aria-current={type==='users'?'page':undefined}>Usuarios</a><a href="/admin/perfiles" aria-current={type==='profiles'?'page':undefined}>Perfiles</a><a href="/admin/roles" aria-current={type==='roles'?'page':undefined}>Roles y permisos</a></nav><p id="security-feedback" class="notice" role="status" hidden></p><div class="workspace-editor"><section class="operations-panel"><div class="operations-toolbar"><input id="security-search" type="search" placeholder={`Buscar ${labels[type].toLowerCase()}…`} aria-label="Buscar registros"/><span class="small-note" id="security-count"></span></div><div class="table-scroll"><table class="operations-table"><thead><tr><th>{type==='users'?'Persona':'Nombre'}</th><th>{type==='users'?'Perfiles':'Accesos'}</th><th>Estado</th><th></th></tr></thead><tbody id="security-list"></tbody></table></div></section><section class="workspace-form"><h2 id="security-title">Nuevo {singular}</h2><p class="small-note" id="security-help"></p><form id="security-form" novalidate></form></section></div><script id="security-data" type="application/json" set:html={JSON.stringify({type,data,me}).replace(/</g,'\\u003c')}/></>}
<script>import '../../../scripts/security-editor';</script></AdminLayout>
