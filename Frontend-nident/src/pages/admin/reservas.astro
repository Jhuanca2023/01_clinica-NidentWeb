---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {api,ApiError} from '../../lib/server/api';
let result:any;let error='';
const query=new URLSearchParams();for(const key of ['status','date','search','page']){const value=Astro.url.searchParams.get(key);if(value)query.set(key,value);}
try{result=(await api('/admin/reservations?'+query,{token:Astro.locals.token})).result;}
catch(e){if(e instanceof ApiError&&e.status===401)return Astro.redirect('/admin/login');error=e instanceof Error?e.message:'No se pudieron cargar las reservas.';}
const labels:Record<string,string>={pending:'Pendiente',confirmed:'Confirmada',cancelled:'Cancelada',completed:'Atendida'};
const pageLink=(page:number)=>{const params=new URLSearchParams(query);params.set('page',String(page));return '/admin/reservas?'+params;};
---
<AdminLayout title="Reservas" active="reservations"><header class="page-heading"><div><h1>Una agenda, cada visita.</h1><p>Revisa las solicitudes y confirma la fecha directamente con el paciente. Horarios de Perú.</p></div><a class="secondary button" href="/reservar" target="_blank" rel="noopener">Ver formulario de reservas</a></header><form class="reservation-filters" method="get"><label>Buscar por nombre o código<input name="search" value={query.get('search') || ''} maxlength="120"/></label><label>Estado<select name="status"><option value="">Todos</option>{Object.entries(labels).map(([key,label])=><option value={key} selected={query.get('status')===key}>{label}</option>)}</select></label><label>Fecha<input type="date" name="date" value={query.get('date') || ''}/></label><button class="primary">Filtrar reservas</button><a href="/admin/reservas">Limpiar</a></form><p class="notice" id="reservation-feedback" role="status" hidden></p>
{error?<p class="notice error">{error}</p>:<><div class="reservation-results"><span>{result.total} solicitudes</span><span>Página {result.current_page} de {result.last_page}</span></div>{result.data.length===0?<section class="operational-note"><h2>No hay reservas en esta vista.</h2><p>Las solicitudes del formulario aparecerán aquí. Prueba otros filtros si buscas una reserva existente.</p></section>:<div class="reservation-list">{result.data.map((r:any)=><details class="reservation-row"><summary><div><b>{r.name}</b><span>{r.code} · {r.treatment} · {r.branch}</span></div><div><b>{r.preferred_date} · {r.preferred_time}</b><span class={'reservation-status '+r.status}>{labels[r.status]}</span></div></summary><div class="reservation-detail"><div><h2>Contacto del paciente</h2><p><a href={'mailto:'+r.email}>{r.email}</a></p><p><a href={'tel:'+r.phone.replace(/[^+0-9]/g,'')}>{r.phone}</a></p><p class="small-note">Verifica disponibilidad antes de confirmar. La solicitud no bloquea un consultorio ni un profesional.</p></div><form data-reservation={r.id} data-version={r.version}><div class="form-grid"><label>Fecha acordada<input type="date" name="preferred_date" value={r.preferred_date} required/></label><label>Hora acordada<input type="time" name="preferred_time" value={r.preferred_time} required/></label><label>Estado<select name="status">{Object.entries(labels).filter(([s])=>s===r.status||(r.status==='pending'&&['confirmed','cancelled'].includes(s))||(r.status==='confirmed'&&['cancelled','completed'].includes(s))).map(([s,label])=><option value={s} selected={r.status===s}>{label}</option>)}</select></label></div><label>Nota interna<textarea name="internal_note" maxlength="2000" rows="3">{r.internal_note}</textarea></label><button class="primary" type="submit">Guardar reserva</button><p class="small-note">Al confirmar o cancelar, se prepara el correo si el servicio está activo y su plantilla publicada.</p></form></div></details>)}</div>}<nav class="message-pagination" aria-label="Páginas de reservas">{result.current_page>1&&<a href={pageLink(result.current_page-1)}>Anterior</a>}{result.current_page<result.last_page&&<a href={pageLink(result.current_page+1)}>Siguiente</a>}</nav></>}
<script>
const csrf=document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')!.content;
document.querySelectorAll<HTMLFormElement>('[data-reservation]').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const data=Object.fromEntries(new FormData(form));const feedback=document.getElementById('reservation-feedback')!;try{const response=await fetch('/admin/actions/reservations/'+form.dataset.reservation,{method:'PUT',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify({...data,version:Number(form.dataset.version)})});const json=await response.json();if(!response.ok)throw Error(json.message);location.reload();}catch(error){feedback.textContent=(error as Error).message;feedback.className='notice error';feedback.hidden=false;button.disabled=false;}}));
</script>
</AdminLayout>
