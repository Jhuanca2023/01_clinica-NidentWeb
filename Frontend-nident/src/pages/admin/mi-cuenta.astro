---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Mi cuenta"><header class="page-heading"><div><h1>Mi cuenta</h1><p>Actualiza tu contraseña de acceso al panel.</p></div></header><section class="workspace-form" style="max-width:520px"><form id="own-password"><label>Contraseña actual<input name="current_password" type="password" required autocomplete="current-password"/></label><label>Nueva contraseña<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password"/></label><label>Repetir nueva contraseña<input name="password_confirmation" type="password" required minlength="12" maxlength="128" autocomplete="new-password"/></label><p class="small-note">Al guardar se cerrarán las sesiones de esta cuenta. Podrás entrar con la nueva contraseña.</p><button class="primary" type="submit">Cambiar contraseña</button><p id="account-feedback" role="status"></p></form></section><script>
const form=document.getElementById('own-password') as HTMLFormElement;form?.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const csrf=document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')!.content;try{const response=await fetch('/admin/actions/account/password',{method:'PUT',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const result=await response.json();if(!response.ok)throw Error(result.errors?Object.values(result.errors).flat().join(' '):result.message);const logout=document.createElement('form');logout.method='POST';logout.action='/admin/salir';const field=document.createElement('input');field.type='hidden';field.name='_csrf';field.value=csrf;logout.append(field);document.body.append(logout);logout.submit();}catch(error){document.getElementById('account-feedback')!.textContent=(error as Error).message;button.disabled=false;}});
</script></AdminLayout>
