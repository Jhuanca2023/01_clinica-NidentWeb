---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { api, ApiError } from '../../lib/server/api';
let ready = false; let error = '';
try { const me = (await api('/admin/me', { token: Astro.locals.token })).result; ready = me.permissions.mail; if (!ready) Astro.response.status = 403; }
catch (exception) { if (exception instanceof ApiError && exception.status === 401) return Astro.redirect('/admin/login'); error = 'No pudimos abrir este módulo. Intenta de nuevo.'; }
---
<AdminLayout title="Correos y plantillas" active="mail">
<header class="page-heading"><div><h1>Correos y plantillas</h1><p>Una comunicación clara, con la voz de Nident.</p></div><div class="editor-toolbar"><span id="save-state" class="save-state" role="status">Cargando plantillas…</span><button id="save-template" class="secondary" disabled>Guardar borrador</button><button id="publish-template" class="primary" disabled>Publicar</button></div></header>
{ready ? <div id="mail-app"><aside id="mail-health" class="mail-service-banner" role="status">Comprobando el servicio de correo…</aside><nav class="tab-bar" aria-label="Secciones de correo"><button class="active" data-tab="templates" aria-pressed="true">Plantillas</button><button data-tab="settings" aria-pressed="false">Configuración de envío</button><button data-tab="deliveries" aria-pressed="false">Entregas recientes</button></nav><p id="mail-feedback" class="notice" role="status" hidden></p>
<section data-panel="templates"><div class="mail-workbench"><aside class="template-library"><h2>Tus comunicaciones</h2><div id="template-list" class="template-list"></div><p class="small-note">Reservas, contacto y reclamaciones usan su plantilla publicada. Los cambios de borrador se aplican al publicar.</p></aside><div class="mail-canvas-area"><div class="canvas-topline"><span id="template-name">Selecciona una plantilla</span><div><button class="text-button" id="show-canvas" aria-pressed="true">Editar</button><button class="text-button" id="show-preview" aria-pressed="false">Vista final</button></div></div><div id="canvas-scroll"><div class="email-paper"><div class="email-brand">nident<span>.</span></div><div id="email-blocks"></div><div id="canvas-footer"></div></div></div><iframe id="mail-preview" title="Vista previa final del correo con datos de ejemplo" sandbox="" hidden></iframe><div class="canvas-bottom"><label for="add-block">Añadir bloque</label><select id="add-block"><option value="text">Texto</option><option value="heading">Título</option><option value="image">Imagen</option><option value="button">Botón</option><option value="divider">Separador</option></select><button id="insert-block" class="secondary">Añadir</button></div></div>
<aside class="block-inspector"><h2>Contenido del correo</h2><label>Asunto<input id="mail-subject" maxlength="180"/></label><label>Texto de vista previa<input id="mail-preheader" maxlength="220"/></label><label>Color de marca<input id="mail-accent" type="color"/></label><label>Pie del correo<textarea id="mail-footer" rows="3" maxlength="600"></textarea></label><hr/><h3 id="block-heading">Bloque seleccionado</h3><label id="block-text-label">Texto<textarea id="block-text" rows="5" maxlength="4000"></textarea></label><label id="block-url-label" hidden>Enlace HTTPS<input id="block-url" type="url" placeholder="https://"/></label><label id="block-alt-label" hidden>Descripción de la imagen<input id="block-alt" maxlength="180"/></label><div class="block-actions"><button id="block-up" class="secondary" aria-label="Subir bloque">Subir</button><button id="block-down" class="secondary" aria-label="Bajar bloque">Bajar</button><button id="block-delete" class="danger">Eliminar</button></div><h3>Personalización</h3><p class="small-note">Añade una variable al texto del bloque seleccionado.</p><div id="variable-list" class="variable-list"></div><details class="test-mail"><summary>Enviar una prueba</summary><p class="small-note">Usa la versión publicada. Requiere configurar y activar el servicio de envío.</p><label>Correo de prueba<input id="test-recipient" type="email" autocomplete="email"/></label><button id="test-template" class="secondary">Enviar prueba</button></details></aside></div></section>
<section data-panel="settings" hidden><div class="settings-intro"><h2>Tu canal de comunicación.</h2><p>Configura una cuenta del dominio de la clínica. La contraseña se guarda cifrada y nunca se devuelve al navegador.</p></div><form id="mail-settings-form" class="settings-form"><div class="form-grid"><label>Nombre del remitente<input name="from_name" required maxlength="120"/></label><label>Correo del remitente<input name="from_address" type="email" maxlength="180"/></label><label>Responder a<input name="reply_to" type="email" maxlength="180"/></label><label>Recibir mensajes de contacto en<input name="contact_to" type="email" maxlength="180"/></label><label>Modo de envío<select name="transport"><option value="array">Simulación, sin enviar</option><option value="smtp">SMTP profesional</option></select></label><label>Servidor SMTP<input name="host" autocomplete="off" placeholder="smtp.tudominio.com"/></label><label>Puerto<input name="port" type="number" min="1" max="65535" value="587" required/></label><label>Cifrado<select name="encryption"><option value="tls">STARTTLS</option><option value="ssl">TLS implícito</option></select></label><label>Usuario SMTP<input name="username" autocomplete="off"/></label><label>Contraseña SMTP<input name="password" type="password" autocomplete="new-password" placeholder="Deja vacío para conservar la contraseña"/><span id="password-state" class="small-note"></span></label></div><label class="checkbox-field"><input name="enabled" type="checkbox"/>Activar este servicio de correo</label><p class="small-note">La simulación procesa la prueba sin contactar a un servidor. Para entrega real, el dominio debe tener SPF, DKIM y DMARC configurados con su proveedor.</p><button type="submit" class="primary">Guardar configuración</button></form></section>
<section data-panel="deliveries" hidden><div class="settings-intro"><h2>Cada mensaje, con seguimiento.</h2><p>El estado refleja el procesamiento de la cola; “enviado” significa aceptado por el transporte, no recibido en la bandeja del destinatario.</p><button id="refresh-deliveries" class="secondary">Actualizar entregas</button></div><div id="delivery-list" class="delivery-list"></div></section></div> : <p class="notice error">{error || 'Tu cuenta no tiene permiso para administrar correos.'}</p>}
<script>import '../../scripts/mail-editor';</script>
</AdminLayout>
