---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {api,ApiError} from '../../lib/server/api';
let settings:any;let error='';
try{settings=(await api('/admin/site/settings',{token:Astro.locals.token})).result;}
catch(e){if(e instanceof ApiError && e.status===401)return Astro.redirect('/admin/login');error=e instanceof Error?e.message:'No se pudieron cargar los sliders.';}
---
<AdminLayout title="Sliders de inicio" active="sliders"><header class="page-heading"><div><h1>La primera sonrisa de tu web.</h1><p>Edita cada slider haciendo clic en su imagen, sus textos o su botón.</p></div><a class="secondary button" href="/" target="_blank" rel="noopener">Ver inicio</a></header>
{error?<p class="notice error">{error}</p>:<><div class="studio-toolbar"><span id="slider-state" role="status">{settings.content.hero.length} sliders publicados</span><div><button id="new-slide" class="secondary">Nuevo slider</button><button id="save-slides" class="primary" disabled>Guardar y publicar</button></div></div><p id="slider-feedback" class="notice" role="status" hidden></p><div class="slider-thumbnails" id="slide-list" aria-label="Seleccionar slider"></div><div class="site-studio"><section class="slider-stage"><div class="slider-live" id="slider-live"><button class="slider-picture" data-slide-field="image" aria-label="Editar imagen del slider"><img id="slider-image" alt=""/><span>Cambiar imagen</span></button><div class="slider-copy"><button data-slide-field="title" class="slider-title" id="slide-title"></button><button data-slide-field="line" class="slider-line" id="slide-line"></button><button data-slide-field="description" class="slider-description" id="slide-description"></button><button data-slide-field="cta" class="slider-cta" id="slide-cta"></button></div></div><div class="slide-order-controls"><button class="secondary" id="slide-prev">Mover antes</button><button class="secondary" id="slide-next">Mover después</button><button class="danger" id="slide-remove">Eliminar slider</button></div></section><aside class="site-inspector"><h2>Editar slider</h2><p class="small-note">Selecciona el contenido en el lienzo o cambia un campo directamente.</p><div id="slide-fields"></div></aside></div><script type="application/json" id="slider-data" set:html={JSON.stringify(settings).replace(/</g,'\\u003c')}/><script>import '../../scripts/slider-editor';</script></>}
</AdminLayout>
