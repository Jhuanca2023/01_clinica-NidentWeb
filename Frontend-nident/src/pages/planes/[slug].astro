---
import {publicSite} from '../../lib/server/public-site';
import type {Plan} from '../../lib/content-collections';
const {page,parts,collections,error}=await publicSite('/promociones');
const plan=collections?.plans?.items.find((item:Plan)=>item.visible&&item.slug===Astro.params.slug) as Plan|undefined;
if(error)Astro.response.status=503;else if(!plan)Astro.response.status=404;
const header=parts[0].match(/<header\b[\s\S]*?<\/header>/)?.[0] || '';
const footer=parts[0].match(/<footer\b[\s\S]*?<\/footer>/)?.[0] || '';
const base=process.env.PUBLIC_SITE_URL || import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
---
<!doctype html><html lang="es"><head><Fragment set:html={page?.head || '<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'}/><title>{plan?`${plan.title} · Nident`:'Plan no disponible · Nident'}</title><meta name="description" content={plan?.summary || ''}/><link rel="canonical" href={new URL(Astro.url.pathname,base).href}/></head><body class="nident"><Fragment set:html={header}/><main id="contenido" class="wrap">{plan&&!error?<><div class="breadcrumbs"><a href="/">Inicio</a><span>/</span><a href="/promociones">Planes</a><span>/</span>{plan.title}</div><section class="pack-hero"><div><h1>{plan.title}</h1><p>{plan.summary}</p><div class="pack-price">{plan.price}<small>{plan.price_note}</small></div><a class="btn pri" href={'/reservar?plan='+encodeURIComponent(plan.slug)}>{plan.cta}</a></div>{plan.image&&<img src={plan.image} alt={plan.alt}/>}</section>{plan.features.length>0&&<section class="sec"><h2>Qué incluye</h2><ul class="pack-checks">{plan.features.map(feature=><li>{feature}</li>)}</ul></section>}{plan.sections.map(section=><section class="sec plan-detail-section"><h2>{section.title}</h2><p>{section.body}</p></section>)}{plan.conditions&&<section class="sec plan-detail-section"><h2>Condiciones</h2><p>{plan.conditions}</p></section>}<section class="pack-end"><h2>Conversemos sobre tu visita.</h2><div><a class="btn pri" href={'/reservar?plan='+encodeURIComponent(plan.slug)}>{plan.cta}</a><a class="text-link" href="/contacto">Hacer una consulta</a></div></section></>:<section class="sec"><h1>{error?'El servicio no está disponible.':'Este plan no está disponible.'}</h1><a href="/promociones">Ver planes publicados</a></section>}</main><Fragment set:html={footer}/></body></html>
<style>.plan-detail-section{max-width:800px}.plan-detail-section h2{text-align:left!important;margin-bottom:24px}.plan-detail-section p{white-space:pre-line;line-height:1.85}.pack-checks{margin-top:24px}.pack-hero:not(:has(>img)){grid-template-columns:1fr;max-width:800px}</style>
