---
const {planName=''}=Astro.props as {planName?:string};
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
---
<section class="reservation-public wrap"><div><h1>Tu próxima visita empieza aquí.</h1><p>Cuéntanos cuándo te gustaría venir. Nuestro equipo revisará la disponibilidad y coordinará contigo la confirmación.</p><p class="reservation-public-note">Enviar este formulario registra una solicitud. La cita queda confirmada cuando la clínica te lo comunique.</p></div><form id="reservation-public-form"><div class="reservation-public-grid"><label>Nombre y apellidos<input name="name" autocomplete="name" required minlength="3" maxlength="120"/></label><label>Correo electrónico<input type="email" name="email" autocomplete="email" required maxlength="180"/></label><label>Teléfono de contacto<input type="tel" name="phone" autocomplete="tel" required minlength="6" maxlength="40"/></label><label>Tratamiento de interés<select name="treatment" required><option value="">Selecciona una opción</option>{planName&&<option value={planName} selected>{planName}</option>}{['Evaluación general','Ortodoncia','Endodoncia','Implantes','Odontopediatría','Periodoncia','Diseño de sonrisa','Limpieza y blanqueamiento'].map(t=><option>{t}</option>)}</select></label><label>Sede preferida<select name="branch" required><option value="">Selecciona una sede</option>{['La Esperanza','Trujillo Centro','El Porvenir','Mall Plaza','Por coordinar'].map(s=><option>{s}</option>)}</select></label><label>Fecha preferida<input name="preferred_date" type="date" required min={today}/></label><label>Hora preferida · Perú<input name="preferred_time" type="time" required/></label></div><label class="contact-consent"><input type="checkbox" name="privacy" required/><span>Acepto la <a href="/privacidad">política de privacidad</a> para atender mi solicitud.</span></label><label aria-hidden="true" style="position:absolute;left:-9999px">Sitio web<input name="website" tabindex="-1" autocomplete="off"/></label><button type="submit" class="btn pri">Solicitar mi cita</button><p id="reservation-public-feedback" role="status" aria-live="polite"></p></form></section>
<script>
const form=document.getElementById('reservation-public-form') as HTMLFormElement|null;
if(form){let requestId=crypto.randomUUID();let pendingBody:string|undefined;form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;const feedback=document.getElementById('reservation-public-feedback')!;const fields=Object.fromEntries(new FormData(form));const serialized=JSON.stringify(fields);if(pendingBody!==undefined&&pendingBody!==serialized)requestId=crypto.randomUUID();pendingBody=serialized;feedback.textContent='Registrando tu solicitud…';try{const response=await fetch('/api/reservas',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...fields,privacy:true,request_id:requestId})});const data=await response.json();if(!response.ok)throw Error(data.errors?Object.values(data.errors).flat().join(' '):data.message);feedback.textContent=`${data.message} Tu código es ${data.result.code}.`;form.reset();requestId=crypto.randomUUID();pendingBody=undefined;}catch(e){feedback.textContent=(e as Error).message;}finally{button.disabled=false;}});}
</script>
<style>
.reservation-public{padding-top:64px;padding-bottom:80px;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:64px}.reservation-public h1{font-size:clamp(2rem,4vw,3.5rem);line-height:1.12;letter-spacing:-.03em;margin:0 0 24px}.reservation-public p{line-height:1.7}.reservation-public-note{margin-top:24px;color:#5a4e69}.reservation-public form{padding:30px;background:#f5f2f9;border-radius:16px}.reservation-public-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.reservation-public label{display:grid;gap:8px;font-size:14px}.reservation-public input,.reservation-public select{width:100%;min-width:0;background:#fff;border:1px solid #d4c9e4;border-radius:8px;padding:12px;font:inherit}.reservation-public .contact-consent{display:flex;gap:10px;margin:24px 0}.reservation-public .contact-consent input{width:18px;height:18px}.reservation-public button:disabled{opacity:.6;cursor:wait}#reservation-public-feedback{margin-top:20px}@media(max-width:760px){.reservation-public{grid-template-columns:1fr;gap:24px;padding-top:32px}.reservation-public-grid{grid-template-columns:1fr}.reservation-public form{padding:20px}}
</style>
