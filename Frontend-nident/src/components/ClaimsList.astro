---
import AdminIcon from './AdminIcon.astro';import {claimLabel,claimDate}from'../lib/claims';
const {result,business,me,query}=Astro.props;const pageLink=(page:number)=>{const params=new URLSearchParams(query);params.set('page',String(page));return '/admin/reclamaciones?'+params;};
---
<header class="page-heading"><div><h1>Libro de Reclamaciones</h1><p>Consulta las solicitudes y abre una ficha para iniciar su revisión.</p></div><a class="secondary button" href="/libro-reclamaciones" target="_blank" rel="noopener">Ver formulario público</a></header>
{me?.permissions.security&&<details class="operations-panel" style="margin-bottom:22px"><summary>Datos del proveedor {business?.tax_id?'':'· pendientes de completar'}</summary><form id="business-form" class="form-grid" data-version={business?.version} style="margin-top:22px">{Object.entries({commercial_name:'Nombre comercial',legal_name:'Razón social',tax_id:'RUC',address:'Domicilio del proveedor',email:'Correo de atención'}).map(([key,label])=><label>{label}<input name={key} value={business?.[key]||''} required maxlength={key==='tax_id'?11:300}/></label>)}<button class="primary" type="submit">Guardar datos del proveedor</button><p id="business-feedback" role="status"></p></form></details>}
<form method="get" class="reservation-filters"><label>Buscar solicitud<input name="search" value={query.get('search')||''} maxlength="120" placeholder="Número, referencia, nombre, correo o teléfono"/></label><label>Estado<select name="status"><option value="">Todos</option>{Object.entries({received:'Pendiente',reviewing:'En proceso',answered:'Finalizado'}).map(([value,label])=><option value={value} selected={query.get('status')===value}>{label}</option>)}</select></label><label>Tipo<select name="type"><option value="">Todos</option><option value="reclamo" selected={query.get('type')==='reclamo'}>Reclamo</option><option value="queja" selected={query.get('type')==='queja'}>Queja</option></select></label><label>Resultado<select name="outcome"><option value="">Todos</option><option value="resolved" selected={query.get('outcome')==='resolved'}>Resuelto</option><option value="rejected" selected={query.get('outcome')==='rejected'}>Rechazado</option></select></label><label>Registros por página<select name="per_page">{[10,15,20,25,50,100].map(size=><option value={size} selected={String(size)===(query.get('per_page')||'15')}>{size}</option>)}</select></label><button class="primary">Filtrar</button><a href="/admin/reclamaciones">Limpiar filtros</a></form>
<section class="operations-panel" style="margin-top:22px"><div class="operations-toolbar"><strong>{result.total} solicitudes</strong><span class="small-note">Página {result.current_page} de {result.last_page}</span></div><div class="table-scroll"><table class="operations-table claims-table"><thead><tr><th>N.º reclamo</th><th>Tipo</th><th>Nombre completo</th><th>Correo</th><th>Teléfono</th><th>Departamento</th><th>Estado</th><th>Fecha de registro</th><th>Fecha de resultado</th><th>Acciones</th></tr></thead><tbody>{result.data.map((claim:any)=><tr><td><a href={'/admin/reclamaciones/'+claim.id}><strong>{claim.number}</strong></a><small>{claim.reference}</small></td><td><span class={'claim-type '+claim.type}>{claim.type==='queja'?'Queja':'Reclamo'}</span></td><td>{claim.name}</td><td>{claim.email}</td><td>{claim.phone}</td><td>{claim.department||'No indicado'}</td><td><span class={'claim-state '+(claim.outcome==='rejected'?'rejected':claim.status)}>{claimLabel(claim.status,claim.outcome)}</span></td><td>{claimDate(claim.created_at)}</td><td>{claimDate(claim.answered_at)}</td><td><a class="secondary button" href={'/admin/reclamaciones/'+claim.id} aria-label={'Ver y atender '+claim.number}><AdminIcon name="external" size={15}/>Ver</a></td></tr>)}</tbody></table></div>{!result.data.length&&<p class="empty-state">No hay solicitudes en esta vista. Prueba otros filtros.</p>}<nav class="message-pagination" aria-label="Páginas de reclamaciones">{result.current_page>1&&<a href={pageLink(result.current_page-1)}>Anterior</a>}<span>Página {result.current_page} de {result.last_page}</span>{result.current_page<result.last_page&&<a href={pageLink(result.current_page+1)}>Siguiente</a>}</nav></section>
<script>
const form=document.getElementById('business-form') as HTMLFormElement|null;form?.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const note=document.getElementById('business-feedback')!;try{const response=await fetch('/admin/actions/security/business',{method:'PUT',headers:{'Content-Type':'application/json','X-CSRF-Token':document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')!.content},body:JSON.stringify({...Object.fromEntries(new FormData(form)),version:Number(form.dataset.version)})});const result=await response.json();if(!response.ok)throw Error(result.errors?Object.values(result.errors).flat().join(' '):result.message);form.dataset.version=String(result.result.version);note.textContent='Datos del proveedor guardados.';}catch(error){note.textContent=(error as Error).message;}finally{button.disabled=false;}});
</script>
