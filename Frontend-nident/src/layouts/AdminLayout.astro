---
import '../styles/admin.css';
import '../styles/admin-modules.css';
import '../styles/admin-workspace.css';
import '../styles/admin-sidebar.css';
import AdminIcon from '../components/AdminIcon.astro';
import {api} from '../lib/server/api';
interface Props {title:string;active?:string;publicPage?:boolean}
const {title,active='',publicPage=false}=Astro.props;
let staff:any=null;
if(!publicPage&&Astro.locals.token){try{staff=(await api('/admin/me',{token:Astro.locals.token})).result;}catch{}}
const permissions=staff?.permissions || {};
const groups=[
 {name:'Clínica',links:[['reservations','Reservas','/admin/reservas','calendar','reservations'],['attention','Mensajes','/admin/mensajes','inbox','attention'],['claims','Libro de Reclamaciones','/admin/reclamaciones','book','claims']]},
 {name:'Contenido',links:[['sliders','Sliders','/admin/sliders','sliders','site'],['reviews','Reseñas','/admin/resenas','star','site'],['plans','Planes y promociones','/admin/planes','grid','site'],['catalog','Productos','/admin/productos','box','catalog']]},
 {name:'Sitio web',links:[['encabezado','Encabezado y menú','/admin/sitio/encabezado','grid','site'],['inicio','Página de inicio','/admin/sitio/inicio','home','site'],['tratamientos','Tratamientos','/admin/sitio/tratamientos','grid','site'],['nosotros','Nosotros y sedes','/admin/sitio/nosotros','image','site'],['promociones','Página de promociones','/admin/sitio/promociones','grid','site'],['contacto','Página de contacto','/admin/sitio/contacto','inbox','site'],['footer','Footer','/admin/sitio/footer','grid','site'],['site','Páginas y SEO','/admin/sitio','settings','site']]},
 {name:'Administración',links:[['mail','Correos y plantillas','/admin/correos','mail','mail'],['users','Usuarios','/admin/usuarios','users','security'],['profiles','Perfiles','/admin/perfiles','shield','security'],['roles','Roles y permisos','/admin/roles','key','security']]}
].map(group=>({...group,links:group.links.filter(link=>permissions[link[4]])})).filter(group=>group.links.length);
const initials=String(staff?.name || 'Nident').split(' ').slice(0,2).map(word=>word[0]).join('').toUpperCase();
const selected=(id:string)=>active===id||(id==='tratamientos'&&active.startsWith('tratamientos-'));
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="csrf-token" content={Astro.locals.csrf}/><link rel="icon" href="/assets/img/marca/logo1-trim.webp"/><title>{title} · Nident</title></head><body class:list={['admin-body',{'auth-body':publicPage}]}>
{!publicPage&&<>
<aside class="admin-sidebar" id="admin-navigation"><a class="admin-brand" href="/admin"><img src="/assets/img/marca/logo1-trim.webp" alt="Nident"/></a><div class="workspace-identity"><span class="workspace-avatar">N</span><div><strong>Nident</strong><span>Administración de la clínica</span></div><span class="workspace-online" title="Espacio de trabajo"></span></div><label class="nav-search"><AdminIcon name="search" size={17}/><span class="sr-only">Buscar módulo</span><input id="module-search" type="search" placeholder="Buscar en el panel"/></label><nav aria-label="Administración"><a class="overview-link" href="/admin" aria-current={active==='home'?'page':undefined}><AdminIcon name="home"/><span>Resumen</span></a>{groups.map((group)=><details open={group.name!=='Sitio web'||group.links.some(link=>selected(link[0]))}><summary>{group.name}<span>{group.links.length}</span></summary>{group.links.map(([id,label,href,icon])=><a data-module-link href={href} aria-current={selected(id)?'page':undefined}><AdminIcon name={icon} size={18}/><span>{label}</span>{selected(id)&&<i class="nav-current-dot"></i>}</a>)}</details>)}</nav><div class="sidebar-bottom"><a href="/consultar-solicitud" target="_blank" rel="noopener"><AdminIcon name="search" size={17}/>Consultar una referencia</a><form method="post" action="/admin/salir"><input type="hidden" name="_csrf" value={Astro.locals.csrf}/><button class="text-button" type="submit"><AdminIcon name="logout" size={17}/>Cerrar sesión</button></form></div></aside>
<header class="admin-topbar"><button id="toggle-navigation" aria-label="Mostrar navegación" aria-expanded="false" aria-controls="admin-navigation"><AdminIcon name="menu"/></button><div class="workspace-breadcrumb"><span>Administración</span><AdminIcon name="chevron" size={13}/><strong>{title}</strong></div><div class="workspace-top-actions"><a class="workspace-view-site" href="/" target="_blank" rel="noopener">Ver sitio<AdminIcon name="external" size={15}/></a><span class="workspace-divider"></span><a class="workspace-user" href="/admin/mi-cuenta" aria-label="Mi cuenta y contraseña"><span class="workspace-user-avatar">{initials}</span><div><strong>{staff?.name || 'Equipo Nident'}</strong><small>{permissions.security?'Administrador principal':'Personal autorizado'}</small></div></a></div></header>
</>}
<main class={publicPage?'auth-main':'admin-main'}><slot/></main>{!publicPage&&<button type="button" id="close-navigation-backdrop" class="navigation-backdrop" aria-label="Cerrar navegación"></button>}
<script>
const toggle=document.getElementById('toggle-navigation');const close=()=>{document.body.classList.remove('navigation-open');toggle?.setAttribute('aria-expanded','false');toggle?.focus();};
toggle?.addEventListener('click',()=>{const open=document.body.classList.toggle('navigation-open');toggle.setAttribute('aria-expanded',String(open));});document.getElementById('close-navigation-backdrop')?.addEventListener('click',close);document.addEventListener('keydown',event=>{if(event.key==='Escape'&&document.body.classList.contains('navigation-open'))close();});
document.getElementById('module-search')?.addEventListener('input',event=>{const term=(event.target as HTMLInputElement).value.toLocaleLowerCase();document.querySelectorAll<HTMLAnchorElement>('[data-module-link]').forEach(link=>{link.hidden=!link.textContent?.toLocaleLowerCase().includes(term);if(term&&link.closest('details'))link.closest('details')!.open=true;});});
</script></body></html>
