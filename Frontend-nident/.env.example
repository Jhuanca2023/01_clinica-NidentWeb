API_INTERNAL_URL=http://127.0.0.1:8000/api/v1
PUBLIC_SITE_URL=http://localhost:4321
# Production: set REDIS_URL in the process environment before starting.
# Without Redis the Node session driver uses private local files for development.
REDIS_URL=
NIDENT_ALLOW_FILE_SESSIONS=false
# Node/local: false. Netlify without API_INTERNAL_URL: build defaults to demo.
NIDENT_DEMO_MODE=false
